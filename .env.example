# Copiați în .env și completați. NU puneți .env în controlul versiunilor.
SECRET_KEY=schimbati-cu-un-sir-lung-aleator
DEBUG=false
ALLOWED_HOSTS=investitii.carmistin.local,10.0.0.10
CSRF_TRUSTED_ORIGINS=http://investitii.carmistin.local

POSTGRES_DB=carmistin
POSTGRES_USER=carmistin
POSTGRES_PASSWORD=schimbati

# Autentificare prin domain controller (Active Directory)
LDAP_SERVER_URI=ldap://dc01.carmistin.local
LDAP_BIND_DN=CN=svc-investitii,OU=Servicii,DC=carmistin,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=DC=carmistin,DC=local
LDAP_GROUP_BASE=DC=carmistin,DC=local
AD_GRUP_ADMIN=INV-Administratori
AD_GRUP_MANAGEMENT=INV-Management
AD_GRUP_COORDONATOR=INV-Coordonatori
AD_GRUP_PM=INV-ProjectManageri
AD_GRUP_FINANCIAR=INV-Financiar

# AI local
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:14b

# SMS pentru codurile de confirmare (ștergere proiect)
# Furnizor: smslink | twilio | consola (demo, fără SMS real)
SMS_FURNIZOR=smslink
# SMSLink.ro → SMS Gateway → Configuration & Settings: perechea Connection ID / Password
SMSLINK_CONNECTION_ID=
SMSLINK_PASSWORD=
